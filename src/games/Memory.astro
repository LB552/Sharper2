---
import GameShell from "../components/GameShell.astro";

const {
    gameTitle,
    gameType,
    gameSlug,
    unlockRequirement,
} = Astro.props;
---

<GameShell {gameTitle} {gameType} {gameSlug} {unlockRequirement}>
    <!-- The demo message is intentionally Memory-specific. -->
    <dialog id="demo-limit-dialog" aria-labelledby="demo-limit-title">
        <h2 id="demo-limit-title">You've completed the Sharper demo!</h2>
        <p>Create an account to unlock all games and keep progressing.</p>
        <div class="demo-actions">
            <a href="/login">Create an account</a>
            <a href="/">Back to games</a>
        </div>
    </dialog>
</GameShell>

<script>
    import { mountGame } from "../utils/gameController.js";
    import { hasReachedDemoLimit, recordDemoRound } from "../utils/demoMode.js";

    const demoDialog = document.querySelector<HTMLDialogElement>(
        "#demo-limit-dialog"
    )!;

    mountGame(document.querySelector<HTMLElement>("#game-shell"), {
        demo: {
            hasReachedLimit: hasReachedDemoLimit,
            recordRound: recordDemoRound,
            showLimit() {
                if (!demoDialog.open) demoDialog.showModal();
            },
        },

        startRound({ board, difficulty, complete, addPoint, announce }) {
            const cardAmount = 10 + difficulty * 2;
            const cards: number[] = [];

            for (let i = 1; i <= cardAmount / 2; i++) {
                cards.push(i, i);
            }

            for (let i = cards.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [cards[i], cards[j]] = [cards[j], cards[i]];
            }

            let active = true;
            let locked = false;

            let firstCard: HTMLButtonElement | null = null;
            let firstIndex: number | null = null;
            let firstWasSeen = false;

            let matchedPairs = 0;
            let goodPoints = 0;
            let badPoints = 0;

            const seenCards = new Set<number>();
            const timeouts = new Set<ReturnType<typeof setTimeout>>();

            function setCardLabel(
                card: HTMLButtonElement,
                index: number,
                state: "hidden" | "revealed" | "matched",
                number?: number
            ) {
                const position = `Card ${index + 1}`;

                if (state === "hidden") {
                    card.setAttribute(
                        "aria-label",
                        `${position}, face down`
                    );
                } else if (state === "revealed") {
                    card.setAttribute(
                        "aria-label",
                        String(number)
                    );
                } else {
                    card.setAttribute(
                        "aria-label",
                        `${position}, number ${number}, matched`
                    );
                    card.setAttribute("aria-disabled", "true");
                }
            }

            function resetTurn() {
                firstCard = null;
                firstIndex = null;
                firstWasSeen = false;
                locked = false;
            }

            function flipCard(
                card: HTMLButtonElement,
                index: number,
                number: number
            ) {
                if (
                    !active ||
                    locked ||
                    card === firstCard ||
                    card.classList.contains("matched") ||
                    card.classList.contains("flipped")
                ) {
                    return;
                }

                const wasSeen = seenCards.has(index);
                seenCards.add(index);

                card.classList.add("flipped");
                card.textContent = String(number);

                setCardLabel(card, index, "revealed", number);

                // First card: remember it and wait for the second card.
                if (firstCard === null) {
                    firstCard = card;
                    firstIndex = index;
                    firstWasSeen = wasSeen;
                    return;
                }

                // Second card: evaluate the pair.
                locked = true;

                const previousCard = firstCard;
                const previousIndex = firstIndex!;

                if (cards[previousIndex] === cards[index]) {
                    goodPoints++;
                    addPoint(true);

                    previousCard.classList.add("matched");
                    card.classList.add("matched");

                    setCardLabel(
                        previousCard,
                        previousIndex,
                        "matched",
                        number
                    );
                    setCardLabel(card, index, "matched", number);

                    matchedPairs++;

                    resetTurn();

                    if (matchedPairs === cards.length / 2) {
                        active = false;
                        locked = true;

                        const total = goodPoints + badPoints;

                        complete({
                            goodPoints,
                            badPoints,
                            percentage: total === 0
                                ? 0
                                : (goodPoints / total) * 100,
                        });
                    }
                } else {
                    const penalized = firstWasSeen || wasSeen;

                    if (penalized) {
                        badPoints++;
                        addPoint(false);
                    }

                    const id = setTimeout(() => {
                        timeouts.delete(id);

                        if (!active) return;

                        previousCard.classList.remove("flipped");
                        card.classList.remove("flipped");

                        previousCard.textContent = "";
                        card.textContent = "";

                        setCardLabel(
                            previousCard,
                            previousIndex,
                            "hidden"
                        );
                        setCardLabel(card, index, "hidden");

                        resetTurn();
                    }, 1000);

                    timeouts.add(id);
                }
            }

            board.innerHTML = "";

            const cardGrid = document.createElement("div");
            cardGrid.classList.add("memory-grid");
            board.appendChild(cardGrid);

            cards.forEach((number, index) => {
                const card = document.createElement("button");

                card.type = "button";
                card.classList.add("card");
                card.textContent = "";

                setCardLabel(card, index, "hidden");

                card.addEventListener("click", () => {
                    flipCard(card, index, number);
                });

                cardGrid.appendChild(card);
            });

            // Make the first card ready for keyboard navigation.
            cardGrid.querySelector<HTMLButtonElement>(
                ".card"
            )?.focus();

            return () => {
                active = false;

                for (const id of timeouts) {
                    clearTimeout(id);
                }

                timeouts.clear();
            };
        },
    });
</script>

<style>
    :global(#game-board .memory-grid) {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;

        width: 100%;
        max-width: 460px;
        margin: auto;
        padding: 10px;
    }

    :global(#game-board .memory-grid .card) {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 100%;
        aspect-ratio: 1 / 1;

        border: 2px solid var(--theme-color);
        border-radius: 8px;
        background-color: var(--background-color);

        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-color);

        cursor: pointer;
    }

    :global(#game-board .memory-grid .card) {
        font-family: var(--default-font);
    }

    :global(#game-board .memory-grid .card:focus-visible) {
        outline: 3px solid var(--theme-color);
        outline-offset: 3px;
    }

    @media (min-width: 600px) {
        :global(#game-board .memory-grid) {
            grid-template-columns: repeat(6, minmax(0, 1fr));
        }
    }

    #demo-limit-dialog {
        width: min(90vw, 440px);
        padding: 2rem;
        border: 0;
        border-radius: 14px;
        box-shadow: 0 12px 40px #0003;
        text-align: center;
    }
    #demo-limit-dialog::backdrop { background: #0009; }
    .demo-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
    .demo-actions a {
        padding: 0.75rem 1rem;
        border-radius: 8px;
        background: var(--theme-color);
        color: white;
        text-decoration: none;
    }
</style>