---
import GameShell from "../components/GameShell.astro";
const { gameTitle = "Memory", gameType, gameSlug, unlockRequirement = 0 } = Astro.props;
---

<GameShell {gameTitle} {gameType} {gameSlug} {unlockRequirement}>
    <!-- The demo message is intentionally Memory-specific. -->
    <dialog id="demo-limit-dialog" aria-labelledby="demo-limit-title">
        <h2 id="demo-limit-title">You've completed the Sharper demo!</h2>
        <p>Create an account to unlock all games and keep progressing.</p>
        <div class="demo-actions">
            <a href="/login">Create an account</a>
            <a href="/">Back to games</a>
        </div>
    </dialog>
</GameShell>

<script>
    import { mountGame } from "../utils/gameController.js";
    import { hasReachedDemoLimit, recordDemoRound } from "../utils/demoMode.js";

    const demoDialog = document.querySelector<HTMLDialogElement>("#demo-limit-dialog")!;

    mountGame(document.querySelector<HTMLElement>("#game-shell"), {
        demo: {
            hasReachedLimit: hasReachedDemoLimit,
            recordRound: recordDemoRound,
            showLimit() {
                if (!demoDialog.open) demoDialog.showModal();
            },
        },
        startRound({ board, difficulty, complete }) {
            const cardAmount = 10 + difficulty * 2;
            const cards: number[] = [];
            for (let i = 1; i <= cardAmount / 2; i++) cards.push(i, i);
            for (let i = cards.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [cards[i], cards[j]] = [cards[j], cards[i]];
            }

            let active = true;
            let locked = false;
            let firstCard: HTMLDivElement | null = null;
            let firstIndex: number | null = null;
            let firstWasSeen = false;
            let matchedPairs = 0;
            let goodPoints = 0;
            let badPoints = 0;
            const seenCards = new Set<number>();
            const timeouts = new Set<ReturnType<typeof setTimeout>>();

            function resetTurn() {
                firstCard = null;
                firstIndex = null;
                firstWasSeen = false;
                locked = false;
            }

            function flipCard(card: HTMLDivElement, index: number, number: number) {
                if (!active || locked || card === firstCard ||
                    card.classList.contains("matched") || card.classList.contains("flipped")) return;

                const wasSeen = seenCards.has(index);
                seenCards.add(index);
                card.classList.add("flipped");
                card.textContent = String(number);

                if (firstCard === null) {
                    firstCard = card;
                    firstIndex = index;
                    firstWasSeen = wasSeen;
                    return;
                }

                locked = true;
                const previousCard = firstCard;
                const previousIndex = firstIndex!;
                if (cards[previousIndex] === cards[index]) {
                    goodPoints++;
                    previousCard.classList.add("matched");
                    card.classList.add("matched");
                    matchedPairs++;
                    resetTurn();

                    if (matchedPairs === cards.length / 2) {
                        active = false;
                        locked = true;
                        const total = goodPoints + badPoints;
                        complete({
                            goodPoints,
                            badPoints,
                            percentage: total === 0 ? 0 : (goodPoints / total) * 100,
                        });
                    }
                } else {
                    if (firstWasSeen || wasSeen) badPoints++;
                    const id = setTimeout(() => {
                        timeouts.delete(id);
                        if (!active) return;
                        previousCard.classList.remove("flipped");
                        card.classList.remove("flipped");
                        previousCard.textContent = "?";
                        card.textContent = "?";
                        resetTurn();
                    }, 1000);
                    timeouts.add(id);
                }
            }

            board.innerHTML = "";
            cards.forEach((number, index) => {
                const card = document.createElement("div");
                card.classList.add("card");
                card.textContent = "?";
                card.addEventListener("click", () => flipCard(card, index, number));
                board.appendChild(card);
            });

            return () => {
                active = false;
                for (const id of timeouts) clearTimeout(id);
                timeouts.clear();
            };
        },
    });
</script>

<style>
    :global(#game-board) {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 10px;
    }
    :global(#game-board .card) {
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        border-radius: 8px;
        width: 50px;
        height: 50px;
        flex: 0 0 50px;
        background-color: white;
        border: 2px solid royalblue;
        cursor: pointer;
    }
    #demo-limit-dialog {
        width: min(90vw, 440px);
        padding: 2rem;
        border: 0;
        border-radius: 14px;
        box-shadow: 0 12px 40px #0003;
        text-align: center;
    }
    #demo-limit-dialog::backdrop { background: #0009; }
    .demo-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 1rem; }
    .demo-actions a {
        padding: 0.75rem 1rem;
        border-radius: 8px;
        background: var(--theme-color);
        color: white;
        text-decoration: none;
    }
</style>