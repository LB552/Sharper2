---
import GameShell from "../components/GameShell.astro";
const { gameTitle = "Lights", gameType, gameSlug, unlockRequirement = 0 } = Astro.props;
---

<GameShell {gameTitle} {gameType} {gameSlug} {unlockRequirement} />

<script>
    import { mountGame } from "../utils/gameController.js";

    mountGame(document.querySelector<HTMLElement>("#game-shell"), {
        startRound({ board, difficulty, complete }) {
            const LIGHT_COUNT = 6;
            const PHASES_PER_ROUND = 2;
            const INITIAL_DELAY = 250;
            const FLASH_DURATION = 500;
            const FLASH_DELAY = 250;
            const CLICK_DURATION = 200;
            const PHASE_DELAY = 1000;

            let active = true;
            let inputLocked = true;
            let sequence: number[] = [];
            let playerSequence: number[] = [];
            let wins = 0;
            let losses = 0;
            let currentPhase = 0;
            const timeouts = new Set<ReturnType<typeof setTimeout>>();

            function schedule(callback: () => void, ms: number) {
                const id = setTimeout(() => {
                    timeouts.delete(id);
                    if (active) callback();
                }, ms);
                timeouts.add(id);
            }

            function delay(ms: number) {
                return new Promise<void>((resolve) => schedule(resolve, ms));
            }

            function generateSequence() {
                sequence = [];
                for (let i = 0; i < 5 + difficulty; i++) {
                    sequence.push(Math.floor(Math.random() * LIGHT_COUNT));
                }
            }

            async function flashSequence() {
                inputLocked = true;
                const lights = board.querySelectorAll<HTMLDivElement>(".light");
                await delay(INITIAL_DELAY);
                if (!active) return;
                for (const index of sequence) {
                    lights[index].classList.add("active");
                    await delay(FLASH_DURATION);
                    if (!active) return;
                    lights[index].classList.remove("active");
                    await delay(FLASH_DELAY);
                    if (!active) return;
                }
                inputLocked = false;
            }

            function startPhase() {
                if (!active) return;
                playerSequence = [];
                generateSequence();
                void flashSequence();
            }

            function finishPhase(won: boolean) {
                inputLocked = true;
                if (won) wins++;
                else losses++;
                currentPhase++;
                if (currentPhase === PHASES_PER_ROUND) {
                    active = false;
                    complete({ wins, losses });
                } else {
                    schedule(startPhase, PHASE_DELAY);
                }
            }

            function clickLight(index: number, light: HTMLDivElement) {
                if (!active || inputLocked) return;
                playerSequence.push(index);
                light.classList.add("active");
                schedule(() => light.classList.remove("active"), CLICK_DURATION);
                const position = playerSequence.length - 1;
                if (sequence[position] !== index) finishPhase(false);
                else if (playerSequence.length === sequence.length) finishPhase(true);
            }

            board.innerHTML = "";
            for (let i = 0; i < LIGHT_COUNT; i++) {
                const light = document.createElement("div");
                light.classList.add("light");
                light.addEventListener("click", () => clickLight(i, light));
                board.appendChild(light);
            }
            startPhase();

            return () => {
                active = false;
                for (const id of timeouts) clearTimeout(id);
                timeouts.clear();
            };
        },
    });
</script>

<style>
    :global(#game-board) {
        display: flex;
        justify-content: center;
        gap: 15px;
        padding: 10px;
    }
    :global(#game-board .light) {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: white;
        border: 2px solid royalblue;
        cursor: pointer;
    }
    :global(#game-board .light.active) { background-color: royalblue; }
</style>