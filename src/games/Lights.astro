---
const { gameType, gameSlug } = Astro.props;
---

<div id="game-board" data-game-type={gameType} data-game-slug={gameSlug}></div>
<p id="game-status" role="status" aria-live="polite"></p>
<button id="retry-button" type="button" hidden>Retry</button>

<script>
    import { DEFAULT_DIFFICULTY, handleLevel } from "../utils/levelHandler";
    import { waitForAuth, loadDifficulty, saveDifficulty } from "../utils/gameProgress";

    const gameBoard = document.querySelector<HTMLDivElement>("#game-board")!;
    const status = document.querySelector<HTMLParagraphElement>("#game-status")!;
    const retryButton = document.querySelector<HTMLButtonElement>("#retry-button")!;
    const gameType = gameBoard.dataset.gameType ?? "";
    const gameSlug = gameBoard.dataset.gameSlug ?? "";

    const lightCount = 6;
    const roundsPerSession = 2;
    const initialDelay = 250;
    const flashDuration = 500;
    const flashDelay = 250;
    const clickDuration = 200;
    const roundDelay = 1000;
    const sessionDelay = 1000;

    let user: Awaited<ReturnType<typeof waitForAuth>> = null;
    let difficulty = DEFAULT_DIFFICULTY;
    let sequence: number[] = [];
    let playerSequence: number[] = [];
    let wins = 0;
    let losses = 0;
    let currentRound = 0;
    let gameLocked = true;
    let gameFinished = false;
    let saving = false;
    let pendingResult: { wins: number; losses: number } | null = null;

    const sleep = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms));

    function generateSequence() {
        sequence = [];
        const flashAmount = 5 + difficulty;
        for (let i = 0; i < flashAmount; i++) {
            sequence.push(Math.floor(Math.random() * lightCount));
        }
    }

    function renderLights() {
        gameBoard.innerHTML = "";
        for (let i = 0; i < lightCount; i++) {
            const light = document.createElement("div");
            light.classList.add("light");
            light.addEventListener("click", () => clickLight(i, light));
            gameBoard.appendChild(light);
        }
    }

    async function flashSequence() {
        gameLocked = true;
        const lights = gameBoard.querySelectorAll<HTMLDivElement>(".light");
        await sleep(initialDelay);

        for (const index of sequence) {
            lights[index].classList.add("active");
            await sleep(flashDuration);
            lights[index].classList.remove("active");
            await sleep(flashDelay);
        }

        gameLocked = false;
    }

    function clickLight(index: number, light: HTMLDivElement) {
        if (gameLocked || gameFinished) return;

        playerSequence.push(index);
        light.classList.add("active");
        setTimeout(() => light.classList.remove("active"), clickDuration);

        const currentIndex = playerSequence.length - 1;
        if (sequence[currentIndex] !== index) {
            finishRound(false);
        } else if (playerSequence.length === sequence.length) {
            finishRound(true);
        }
    }

    function finishRound(won: boolean) {
        gameLocked = true;
        if (won) wins++;
        else losses++;
        currentRound++;

        if (currentRound === roundsPerSession) {
            gameFinished = true;
            pendingResult = { wins, losses };
            void finishGame();
        } else {
            setTimeout(startRound, roundDelay);
        }
    }

    async function finishGame() {
        if (!pendingResult || saving) return;
        saving = true;
        retryButton.hidden = true;

        const levelResult = handleLevel(gameType, difficulty, pendingResult);
        status.textContent = "Saving progress...";

        try {
            await saveDifficulty(gameSlug, levelResult.difficulty, user);
            difficulty = levelResult.difficulty;
            pendingResult = null;
            status.textContent = `Session complete. Difficulty: ${difficulty}.`;
            await sleep(sessionDelay);
            startGame();
        } catch (error) {
            console.error("Could not save Lights progress:", error);
            status.textContent = "Could not save progress. Retry to continue.";
            retryButton.hidden = false;
        } finally {
            saving = false;
        }
    }

    function startRound() {
        playerSequence = [];
        generateSequence();
        void flashSequence();
    }

    function startGame() {
        wins = 0;
        losses = 0;
        currentRound = 0;
        gameFinished = false;
        gameLocked = true;
        pendingResult = null;
        status.textContent = "";
        retryButton.hidden = true;
        renderLights();
        startRound();
    }

    async function initializeGame() {
        retryButton.hidden = true;
        status.textContent = "Loading progress...";
        try {
            user = await waitForAuth();
            difficulty = await loadDifficulty(gameSlug, user);
            startGame();
        } catch (error) {
            console.error("Could not load Lights progress:", error);
            status.textContent = "Could not load progress. Retry to play.";
            retryButton.hidden = false;
        }
    }

    retryButton.addEventListener("click", () => {
        if (gameFinished) void finishGame();
        else void initializeGame();
    });

    void initializeGame();
</script>

<style>
    #game-board {
        display: flex;
        justify-content: center;
        gap: 15px;
        padding: 10px;
    }

    #game-board :global(.light) {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background-color: white;
        border: 2px solid royalblue;
        cursor: pointer;
    }

    #game-board :global(.light.active) {
        background-color: royalblue;
    }
</style>