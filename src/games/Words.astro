---
import GameShell from "../components/GameShell.astro";

const {
    gameTitle = "Words",
    gameType,
    gameSlug,
    unlockRequirement = 0,
} = Astro.props;
---

<GameShell {gameTitle} {gameType} {gameSlug} {unlockRequirement} />

<script>
    import { mountGame } from "../utils/gameController.js";

    const wordPool = [
        "ant", "arm", "ask", "axe",
        "back", "beach", "bench", "brick", "brush",
        "chair", "clap", "clock", "cloud", "crash",
        "dark", "desk", "dog", "dress", "drum",
        "east", "egg", "end", "eye",
        "farm", "fast", "field", "fish", "frog",
        "game", "gate", "gift", "glass", "green",
        "hand", "hat", "hill", "horse", "house",
        "ice", "ink", "itch",
        "jam", "jar", "jet", "jump",
        "key", "kick", "king", "kite",
        "lake", "lamp", "leaf", "light", "lock",
        "map", "milk", "moon", "mouse", "mud",
        "nail", "name", "neck", "nest", "nose",
        "oak", "oar", "oil", "owl",
        "park", "path", "pink", "plant", "plum",
        "quick", "quiz", "quit",
        "rain", "red", "ring", "rock", "rose",
        "sand", "ship", "sleep", "snake", "stone",
        "tail", "tall", "tent", "thumb", "tree",
        "urge", "urn",
        "van", "vest", "vine", "voice",
        "walk", "wall", "wave", "wheel", "wolf",
        "yard", "yarn", "yell", "young",
        "zest", "zinc", "zone", "zip", "zoom"
    ];

    mountGame(document.querySelector<HTMLElement>("#game-shell"), {
        startRound({ board, difficulty, complete }) {
            board.innerHTML = "";

            // Create the word display.
            const wordDisplay = document.createElement("p");
            wordDisplay.className = "word-display";
            board.appendChild(wordDisplay);

            // Create the input field.
            const wordInput = document.createElement("input");
            wordInput.className = "word-input";
            wordInput.type = "text";
            wordInput.maxLength = 5;
            wordInput.autocomplete = "off";
            wordInput.spellcheck = false;
            wordInput.disabled = true;
            wordInput.setAttribute("aria-label", "Enter remembered word");
            board.appendChild(wordInput);

            // Create the Skip button.
            const skipButton = document.createElement("button");
            skipButton.className = "skip-button";
            skipButton.type = "button";
            skipButton.textContent = "Skip";
            skipButton.disabled = true;
            board.appendChild(skipButton);

            // Select random words without duplicates.
            function getRandomWords(words: string[], count: number) {
                const shuffled = [...words];

                for (let i = shuffled.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));
                    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
                }

                return shuffled.slice(0, count);
            }

            const roundWordCount = 15 + difficulty;
            const roundWords = getRandomWords(wordPool, roundWordCount);

            const back = Math.min(6 + difficulty * 2, roundWords.length);

            let active = true;
            let currentWordIndex = 0;
            let goodPoints = 0;
            let badPoints = 0;
            let timeout: ReturnType<typeof setTimeout> | null = null;

            // STAGE 1: MEMORIZATION

            function showPreviewWord(index: number) {
                if (!active) return;

                if (index >= back) {
                    startRecall();
                    return;
                }

                // Show the word for 1 second.
                wordDisplay.textContent = roundWords[index];

                timeout = setTimeout(() => {
                    if (!active) return;

                    // Hide the word for 0.5 seconds.
                    wordDisplay.textContent = "";

                    timeout = setTimeout(() => {
                        showPreviewWord(index + 1);
                    }, 500);
                }, 1000);
            }

            // STAGE 2: RECALL

            function startRecall() {
                if (!active) return;

                wordDisplay.textContent = roundWords[back] ?? "";

                wordInput.disabled = false;
                skipButton.disabled = false;
                wordInput.focus();
            }

            // Advance after a correct answer or a skip.
            function advanceWord() {
                currentWordIndex++;
                wordInput.value = "";

                // All words have been answered or skipped.
                if (currentWordIndex >= roundWords.length) {
                    finishRound();
                    return;
                }

                // Display the next word, if one exists.
                wordDisplay.textContent =
                    roundWords[currentWordIndex + back] ?? "";

                wordInput.focus();
            }

            function checkInput() {
                if (!active || wordInput.disabled) return;

                const answer = wordInput.value.trim().toLowerCase();
                const correctWord = roundWords[currentWordIndex];

                if (answer !== correctWord) return;

                // Correct answer: award a good point.
                goodPoints++;
                advanceWord();
            }

            function skipWord() {
                if (!active || skipButton.disabled) return;

                // Skipped word: award a bad point.
                badPoints++;
                advanceWord();
            }

            function finishRound() {
                active = false;

                wordInput.disabled = true;
                skipButton.disabled = true;
                wordDisplay.textContent = "";

                const total = goodPoints + badPoints;

                complete({
                    goodPoints,
                    badPoints,
                    percentage: total === 0
                        ? 0
                        : (goodPoints / total) * 100,
                });
            }

            wordInput.addEventListener("input", checkInput);
            skipButton.addEventListener("click", skipWord);

            // Begin memorization.
            showPreviewWord(0);

            // Cleanup between rounds.
            return () => {
                active = false;

                if (timeout !== null) {
                    clearTimeout(timeout);
                }

                wordInput.removeEventListener("input", checkInput);
                skipButton.removeEventListener("click", skipWord);
            };
        },
    });
</script>

<style>
    /* GAME BOARD */
    :global(#game-board) {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        flex-wrap: nowrap;
        gap: 12px;
        padding: 20px 10px;
        width: 100%;
        box-sizing: border-box;
    }

    /* DISPLAYED WORD */
    :global(#game-board .word-display) {
        flex: 0 0 100px;
        width: 100px;
        margin: 0;
        font-size: 1.5rem;
        font-weight: 500;
        line-height: 1.2;
        text-align: right;
        overflow: hidden;
    }

    /* WORD INPUT */
    :global(#game-board .word-input) {
        flex: 0 1 220px;
        min-width: 0;
        height: 48px;
        padding: 0 12px;
        box-sizing: border-box;
        border: 2px solid #ccc;
        border-radius: 8px;
        background-color: white;
        color: #222;
        font-family: inherit;
        font-size: 1.25rem;
        outline: none;
        transition: border-color 0.15s ease;
    }

    :global(#game-board .word-input:focus) {
        border-color: var(--theme-color, royalblue);
    }

    :global(#game-board .word-input:disabled) {
        background-color: #f5f5f5;
        cursor: not-allowed;
    }

    /* SKIP BUTTON */
    :global(#game-board .skip-button) {
        flex: 0 0 auto;
        height: 48px;
        padding: 0 18px;
        box-sizing: border-box;
        border: 2px solid var(--theme-color, royalblue);
        border-radius: 8px;
        background-color: var(--theme-color, royalblue);
        color: white;
        font-family: inherit;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: opacity 0.15s ease;
    }

    :global(#game-board .skip-button:hover:not(:disabled)) {
        opacity: 0.85;
    }

    :global(#game-board .skip-button:focus-visible) {
        outline: 3px solid var(--theme-color, royalblue);
        outline-offset: 3px;
    }

    :global(#game-board .skip-button:disabled) {
        opacity: 0.4;
        cursor: not-allowed;
    }

    /* MOBILE */
    @media (max-width: 480px) {
        :global(#game-board) {
            gap: 8px;
            padding: 16px 4px;
        }

        :global(#game-board .word-display) {
            flex: 0 1 76px;
            width: 76px;
            font-size: 1.1rem;
        }

        :global(#game-board .word-input) {
            flex: 1 1 0;
            height: 44px;
            padding: 0 8px;
            font-size: 1rem;
        }

        :global(#game-board .skip-button) {
            height: 44px;
            padding: 0 10px;
            font-size: 0.875rem;
        }
    }

    /* REDUCED MOTION */
    @media (prefers-reduced-motion: reduce) {
        :global(#game-board .word-input),
        :global(#game-board .skip-button) {
            transition: none;
        }
    }
</style>