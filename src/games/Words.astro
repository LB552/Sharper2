---
import GameShell from "../components/GameShell.astro";

const {
    gameTitle,
    gameType,
    gameSlug,
    unlockRequirement,
} = Astro.props;
---

<GameShell {gameTitle} {gameType} {gameSlug} {unlockRequirement} />

<script>
    import { mountGame } from "../utils/gameController.js";

    const wordPool = [
        "ant", "arm", "ask", "axe",
        "back", "beach", "bench", "brick", "brush",
        "chase", "clap", "clock", "cloud", "crash",
        "dark", "dash", "desk", "dog", "dress", "drum",
        "east", "egg", "end", "eye",
        "farm", "fast", "field", "fish", "frog",
        "game", "gate", "gift", "glass", "green",
        "hand", "hat", "hill", "hour", "house",
        "ice", "ink", "itch",
        "jam", "jar", "joke", "jump",
        "key", "kick", "king", "kite",
        "lake", "lamp", "learn", "light", "lock",
        "map", "milk", "moon", "mouse", "mud",
        "nail", "name", "neck", "nest", "nose",
        "oak", "oath", "oil", "owl",
        "park", "path", "pink", "plant", "plum",
        "quick", "quiz", "quit",
        "raid", "rest", "ring", "rock", "rose",
        "sand", "ship", "sleep", "snake", "stone",
        "tab", "tall", "tent", "thumb", "tree",
        "urge", "urn",
        "van", "vest", "vine", "voice",
        "walk", "wall", "wave", "wheat", "wolf",
        "yard", "yarn", "yell", "young",
        "zest", "zinc", "zone", "zoom"
    ];

    mountGame(document.querySelector<HTMLElement>("#game-shell"), {
        startRound({ board, difficulty, complete, addPoint, announce }) {
            board.innerHTML = "";

            const sequenceAnnouncement =
                document.querySelector<HTMLElement>(
                    "#game-sequence-announcement"
                )!;
            sequenceAnnouncement.setAttribute("aria-atomic", "true");
            sequenceAnnouncement.setAttribute("aria-relevant", "additions text");

            // Focus the board before memorization begins.
            // The initial delay allows VoiceOver to finish
            // announcing the focus change.
            board.setAttribute("tabindex", "-1");
            board.setAttribute("aria-label", "Reset");

            sequenceAnnouncement.textContent = "";

            // Create the word display.
            const wordDisplay = document.createElement("p");
            wordDisplay.className = "word-display";
            wordDisplay.tabIndex = -1;
            board.appendChild(wordDisplay);

            // Create the input field.
            const wordInput = document.createElement("input");
            wordInput.className = "word-input";
            wordInput.type = "text";
            wordInput.maxLength = 5;
            wordInput.autocomplete = "off";
            wordInput.spellcheck = false;
            wordInput.disabled = true;
            wordInput.setAttribute(
                "aria-label",
                "Enter remembered word"
            );
            board.appendChild(wordInput);

            // Create the Skip button.
            const skipButton = document.createElement("button");
            skipButton.className = "skip-button";
            skipButton.type = "button";
            skipButton.textContent = "Skip";
            skipButton.disabled = true;
            board.appendChild(skipButton);

            // Select random words without duplicates.
            function getRandomWords(words: string[], count: number) {
                const shuffled = [...words];

                for (let i = shuffled.length - 1; i > 0; i--) {
                    const j = Math.floor(Math.random() * (i + 1));

                    [shuffled[i], shuffled[j]] =
                        [shuffled[j], shuffled[i]];
                }

                return shuffled.slice(0, count);
            }

            const roundWordCount = 15 + difficulty;
            const roundWords = getRandomWords(
                wordPool,
                roundWordCount
            );

            const back = Math.min(
                6 + difficulty * 2,
                roundWords.length
            );

            const INITIAL_DELAY = 2000;
            const INPUT_READY_DELAY = 700;

            let active = true;
            let currentWordIndex = 0;
            let goodPoints = 0;
            let badPoints = 0;

            let timeout: ReturnType<typeof setTimeout> | null = null;
            let readyTimeout: ReturnType<typeof setTimeout> | null = null;

            // Announce a word without changing keyboard focus.
            function announceWord(word: string) {
                if (!active) return;

                sequenceAnnouncement.textContent = word;
            }

            // STAGE 1: MEMORIZATION

            function showPreviewWord(index: number) {
                if (!active) return;

                if (index >= back) {
                    startRecall();
                    return;
                }

                const word = roundWords[index];

                // Display and announce the word immediately.
                wordDisplay.textContent = word;
                announceWord(word);

                timeout = setTimeout(() => {
                    if (!active) return;

                    // Hide the word for 0.5 seconds.
                    wordDisplay.textContent = "";
                    sequenceAnnouncement.textContent = "";

                    timeout = setTimeout(() => {
                        showPreviewWord(index + 1);
                    }, 500);
                }, 1000);
            }

            // STAGE 2: RECALL

            function startRecall() {
                if (!active) return;

                // Make the displayed word keyboard-accessible.
                wordDisplay.tabIndex = 0;

                // Enable input and Skip.
                wordInput.disabled = false;
                skipButton.disabled = false;

                const word = roundWords[back] ?? "";

                wordDisplay.textContent = word;

                // Announce the new word first.
                if (word) {
                    announceWord(word);
                }

                // Then announce that interaction is ready.
                readyTimeout = setTimeout(() => {
                    if (!active) return;

                    announce("Input ready");
                }, INPUT_READY_DELAY);
            }

            // Advance after a correct answer or a skip.
            function advanceWord() {
                currentWordIndex++;
                wordInput.value = "";

                // All words have been answered or skipped.
                if (currentWordIndex >= roundWords.length) {
                    finishRound();
                    return;
                }

                // Display and announce the next word.
                const nextWord =
                    roundWords[currentWordIndex + back] ?? "";

                wordDisplay.textContent = nextWord;

                if (nextWord) {
                    announceWord(nextWord);
                } else {
                    sequenceAnnouncement.textContent = "";
                }

                // Do not move focus. The player can continue
                // typing or navigate using Tab.
            }

            function checkInput() {
                if (!active || wordInput.disabled) return;

                const answer = wordInput.value.trim().toLowerCase();
                const correctWord = roundWords[currentWordIndex];

                // Incorrect answers do nothing.
                if (answer !== correctWord) return;

                goodPoints++;
                addPoint(true);

                advanceWord();
            }

            function skipWord() {
                if (!active || skipButton.disabled) return;

                badPoints++;
                addPoint(false);

                advanceWord();
            }

            function finishRound() {
                active = false;

                wordInput.disabled = true;
                skipButton.disabled = true;
                wordDisplay.tabIndex = -1;
                wordDisplay.textContent = "";
                sequenceAnnouncement.textContent = "";

                if (readyTimeout !== null) {
                    clearTimeout(readyTimeout);
                }

                const total = goodPoints + badPoints;

                complete({
                    goodPoints,
                    badPoints,
                    percentage: total === 0
                        ? 0
                        : (goodPoints / total) * 100,
                });
            }

            wordInput.addEventListener("input", checkInput);
            skipButton.addEventListener("click", skipWord);

            // Begin memorization after VoiceOver has had
            // time to announce the board focus.
            board.focus({ preventScroll: true });

            timeout = setTimeout(() => {
                showPreviewWord(0);
            }, INITIAL_DELAY);

            // Cleanup between rounds.
            return () => {
                active = false;

                if (timeout !== null) {
                    clearTimeout(timeout);
                }

                if (readyTimeout !== null) {
                    clearTimeout(readyTimeout);
                }

                sequenceAnnouncement.textContent = "";

                wordInput.removeEventListener("input", checkInput);
                skipButton.removeEventListener("click", skipWord);
            };
        },
    });
</script>

<style>
    /* GAME BOARD */
    :global(#game-board) {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        flex-wrap: nowrap;
        gap: 12px;
        padding: 20px 10px;
        width: 100%;
        box-sizing: border-box;
    }

    /* DISPLAYED WORD */
    :global(#game-board .word-display) {
        flex: 0 0 100px;
        width: 100px;
        margin: 0;
        font-size: 1.5rem;
        font-weight: 500;
        line-height: 1.2;
        text-align: right;
        overflow: hidden;
    }

    /* WORD INPUT */
    :global(#game-board .word-input) {
        flex: 0 1 220px;
        min-width: 0;
        height: 48px;
        padding: 0 12px;
        box-sizing: border-box;
        border: 2px solid #ccc;
        border-radius: 8px;
        background-color: white;
        color: #222;
        font-family: inherit;
        font-size: 1.25rem;
        outline: none;
        transition: border-color 0.15s ease;
    }

    :global(#game-board .word-input:focus) {
        border-color: var(--theme-color, royalblue);
    }

    :global(#game-board .word-input:disabled) {
        background-color: #f5f5f5;
        cursor: not-allowed;
    }

    /* SKIP BUTTON */
    :global(#game-board .skip-button) {
        flex: 0 0 auto;
        height: 48px;
        padding: 0 18px;
        box-sizing: border-box;
        border: 2px solid var(--theme-color, royalblue);
        border-radius: 8px;
        background-color: var(--theme-color, royalblue);
        color: white;
        font-family: inherit;
        font-size: 1rem;
        font-weight: 500;
        cursor: pointer;
        transition: opacity 0.15s ease;
    }

    :global(#game-board .skip-button:hover:not(:disabled)) {
        opacity: 0.85;
    }

    :global(#game-board .skip-button:focus-visible) {
        outline: 3px solid var(--theme-color, royalblue);
        outline-offset: 3px;
    }

    :global(#game-board .skip-button:disabled) {
        opacity: 0.4;
        cursor: not-allowed;
    }

    /* MOBILE */
    @media (max-width: 480px) {
        :global(#game-board) {
            gap: 8px;
            padding: 16px 4px;
        }

        :global(#game-board .word-display) {
            flex: 0 1 76px;
            width: 76px;
            font-size: 1.1rem;
        }

        :global(#game-board .word-input) {
            flex: 1 1 0;
            height: 44px;
            padding: 0 8px;
            font-size: 1rem;
        }

        :global(#game-board .skip-button) {
            height: 44px;
            padding: 0 10px;
            font-size: 0.875rem;
        }
    }

    /* REDUCED MOTION */
    @media (prefers-reduced-motion: reduce) {
        :global(#game-board .word-input),
        :global(#game-board .skip-button) {
            transition: none;
        }
    }
</style>