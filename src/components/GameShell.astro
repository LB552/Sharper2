---
const { gameTitle, gameType, gameSlug, unlockRequirement = 0 } = Astro.props;
---

<div
    id="game-shell"
    data-game-title={gameTitle}
    data-game-type={gameType}
    data-game-slug={gameSlug}
    data-unlock-requirement={unlockRequirement}
>
    
    <div id="game-start-screen" hidden>
        <h2>Ready to play?</h2>
        <p>Your five-minute daily timer starts when you press Start.</p>
        <button id="game-start-button" type="button">Start</button>
    </div>

    <div id="game-board" hidden></div>

    <div id="game-level-feedback" hidden>
        <p id="game-points">Points: <span id="game-point-symbols"></span></p>
        <p id="game-level-result" aria-live="polite"></p>
    </div>

    <div id="game-two-phase-feedback" hidden>
        <p id="game-phase-results">
            <span id="game-phase-one">−</span>
            |
            <span id="game-phase-two">−</span>
        </p>
        <p id="game-wins-result" aria-live="polite"></p>
    </div>

    <div id="locked-game" hidden>
        <h2 id="locked-title">Unlock {gameTitle}</h2>
        <p id="locked-description"></p>
        <a id="locked-signup" href="/login">Create an account</a>
    </div>

    <p id="daily-timer" role="timer" hidden>Daily time: --:--</p>
    <p id="game-status" role="status" aria-live="polite"></p>

    <div id="daily-limit-message" hidden>
        <h2>Daily time complete</h2>
        <p>Come back tomorrow for another five minutes of {gameTitle}.</p>
        <a href="/">Back to games</a>
    </div>

    <button id="retry-button" type="button" hidden>Retry</button>

    <!-- Game-specific extras, e.g. Memory's demo dialog. -->
    <slot />
</div>

<style>
    #game-shell [hidden] {
        display: none !important;
    }

    #game-level-feedback {
        text-align: center;
        margin: 1rem 0;
    }

    #game-points {
        margin: 0;
        font-weight: 600;
    }

    #game-point-symbols {
        display: inline-flex;
        flex-wrap: wrap;
        gap: 0.25rem;
        vertical-align: middle;
    }

    #game-point-symbols .good-point {
        color: var(--theme-color);
    }

    #game-point-symbols .bad-point {
        color: black;
    }

    #game-level-result {
        margin: 0.5rem 0 0;
        font-weight: bold;
        color: var(--theme-color);
    }

    #game-level-result:empty {
        display: none;
    }

    #daily-timer {
        font-variant-numeric: tabular-nums;
        font-weight: bold;
    }

    #daily-limit-message {
        text-align: center;
        padding: 1rem;
    }

    #locked-game {
        text-align: center;
    }

    #locked-game a {
        color: var(--theme-color);
        font-weight: bold;
    }

    #game-two-phase-feedback {
        text-align: center;
        margin: 1rem 0;
    }

    #game-phase-results {
        margin: 0;
        font-weight: 600;
        font-size: 1.25rem;
    }

    #game-phase-one.good-phase,
    #game-phase-two.good-phase {
        color: var(--theme-color);
    }

    #game-phase-one.bad-phase,
    #game-phase-two.bad-phase {
        color: black;
    }

    #game-wins-result {
        margin: 0.5rem 0 0;
        font-weight: bold;
        color: var(--theme-color);
    }

    #game-wins-result:empty {
        display: none;
    }

    #game-start-screen {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        min-height: 250px;
        padding: 2rem 1rem;
        text-align: center;
    }

    #game-start-screen h2,
    #game-start-screen p {
        margin: 0;
    }

    #game-start-button {
        padding: 0.75rem 2.5rem;
        border: none;
        border-radius: 10px;
        background: var(--theme-color, royalblue);
        color: white;
        font: inherit;
        font-weight: 600;
        cursor: pointer;
    }

    #game-start-button:hover {
        filter: brightness(0.9);
    }

    #game-start-button:focus-visible {
        outline: 3px solid var(--theme-color, royalblue);
        outline-offset: 3px;
    }
</style>