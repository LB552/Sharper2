<header class="site-header">
    <div class="header-user">
        <button
            type="button"
            id="user-info"
            class="user-info"
            aria-label="Open your stats"
            aria-controls="stats-panel"
            aria-expanded="false"
            hidden
        >
            <svg
                class="profile-icon"
                viewBox="0 0 100 100"
                fill="none"
                stroke="currentColor"
                stroke-width="5"
                stroke-linecap="phase"
                stroke-linejoin="phase"
                aria-hidden="true"
            >
                <circle cx="50" cy="50" r="45" />
                <circle cx="50" cy="39" r="17" />
                <path d="M20 83 C24 63 36 56 50 56 C64 56 76 63 80 83" />
            </svg>

            <span id="username"></span>
        </button>
    </div>

    <a href="/" class="site-logo">
        Sharper
    </a>

    <nav class="header-nav" aria-label="Account">
        <button
            id="tutorial-help-button"
            type="button"
            aria-label="How Sharper works"
            title="How Sharper works"
        >
            Help
        </button>

        <a
            href="/login"
            id="login-button"
            class="auth-button"
            hidden
        >
            Log in
        </a>

        <button
            type="button"
            id="logout-button"
            class="auth-button"
            hidden
        >
            Log out
        </button>
    </nav>
</header>

<p id="logout-message" role="alert" hidden></p>

<script>
    import { onAuthStateChanged } from "firebase/auth";
    import { doc, getDoc } from "firebase/firestore";
    import { auth, db } from "../firebase.js";
    import { logout } from "../utils/authHandler.js";

    const loginButton = document.querySelector<HTMLAnchorElement>(
        "#login-button"
    );

    const logoutButton = document.querySelector<HTMLButtonElement>(
        "#logout-button"
    );

    const logoutMessage = document.querySelector<HTMLParagraphElement>(
        "#logout-message"
    );

    const userInfo = document.querySelector<HTMLButtonElement>(
        "#user-info"
    );

    const usernameElement = document.querySelector<HTMLSpanElement>(
        "#username"
    );

    userInfo?.addEventListener("click", () => {
        document.dispatchEvent(new Event("sharper:open-stats"));
    });

    document
        .querySelector("#tutorial-help-button")
        ?.addEventListener("click", () => {
            window.dispatchEvent(new Event("open-sharper-tutorial"));
        });

    // Update buttons and username based on authentication status.
    onAuthStateChanged(auth, async (user) => {
        if (loginButton) {
            loginButton.hidden = !!user;
        }

        if (logoutButton) {
            logoutButton.hidden = !user;
        }

        if (userInfo) {
            userInfo.hidden = true;
        }

        if (usernameElement) {
            usernameElement.textContent = "";
        }

        if (!user) {
            return;
        }

        try {
            const userSnapshot = await getDoc(
                doc(db, "users", user.uid)
            );

            // Ignore an outdated result if the user logged out
            // while the Firestore request was running.
            if (auth.currentUser?.uid !== user.uid) {
                return;
            }

            if (userSnapshot.exists()) {
                const username = userSnapshot.data().username;

                if (typeof username === "string" && username) {
                    if (usernameElement) {
                        usernameElement.textContent = username;
                    }

                    if (userInfo) {
                        userInfo.hidden = false;
                    }
                }
            }
        } catch (error) {
            console.error("Could not load username:", error);
        }
    });

    // Handle logout.
    logoutButton?.addEventListener("click", async () => {
        logoutButton.disabled = true;

        if (logoutMessage) {
            logoutMessage.hidden = true;
            logoutMessage.textContent = "";
        }

        try {
            await logout();

            window.location.href = "/";
        } catch (error) {
            console.error("Logout error:", error);

            if (logoutMessage) {
                logoutMessage.textContent =
                    "Could not log out. Please try again.";
                logoutMessage.hidden = false;
            }

            logoutButton.disabled = false;
        }
    });
</script>

<style>
    .site-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        width: 100%;
        padding: 1rem;
        background-color: var(--theme-color);
    }

    /* Left section: profile icon and username */
    .header-user {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
    }

    .user-info {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        min-width: 0;

        padding: 0;
        border: none;
        background: transparent;

        color: white;
        font: inherit;
        text-align: left;
        cursor: pointer;
    }

    .user-info:focus-visible {
        outline: 3px solid white;
        outline-offset: 4px;
        border-radius: 4px;
    }

    .user-info[hidden] {
        display: none;
    }

    .profile-icon {
        width: 28px;
        height: 28px;
        flex-shrink: 0;
    }

    #username {
        font-size: 0.875rem;
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Center section: site title */
    .site-logo {
        flex-shrink: 0;
        color: white;
        font-size: 1.5rem;
        font-weight: bold;
        text-decoration: none;
    }

    /* Right section: authentication buttons */
    .header-nav {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 1rem;
    }

    .auth-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0.5rem 1rem;
        border: 2px solid white;
        border-radius: 8px;
        background-color: transparent;
        color: white;
        font: inherit;
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition:
            background-color 0.2s ease,
            color 0.2s ease;
    }

    .auth-button:hover {
        background-color: white;
        color: var(--theme-color);
    }

    .auth-button:focus-visible {
        outline: 3px solid white;
        outline-offset: 3px;
    }

    .auth-button:disabled {
        opacity: 0.6;
        cursor: wait;
    }

    .auth-button[hidden] {
        display: none;
    }

    #logout-message {
        margin: 0;
        padding: 0.75rem 1rem;
        color: #b91c1c;
        text-align: center;
    }

    #logout-message[hidden] {
        display: none;
    }

    #tutorial-help-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 40px;
        padding: 0.5rem 0.25rem;

        border: none;
        border-radius: 4px;
        background: transparent;
        color: white;

        font-family: var(--default-font);
        font-size: 1rem;
        font-weight: 600;

        cursor: pointer;
        transition: opacity 0.2s ease;
    }

    #tutorial-help-button:focus-visible {
        outline: 2px solid white;
        outline-offset: 3px;
    }

    @media (min-width: 600px) {
        .site-header {
            padding: 1rem 2rem;
        }

        .auth-button {
            font-size: 1rem;
        }

        #username {
            font-size: 1rem;
        }
    }

    @media (max-width: 480px) {
        .site-header {
            gap: 0.5rem;
        }

        .user-info {
            gap: 0.3rem;
        }

        .profile-icon {
            width: 22px;
            height: 22px;
        }

        #username {
            font-size: 0.75rem;
        }

        .auth-button {
            padding: 0.5rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .auth-button {
            transition: none;
        }
    }
</style>