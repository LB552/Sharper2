<div class="stats-dashboard" id="stats-dashboard">
    <!-- BACKDROP -->
    <div
        id="stats-backdrop"
        class="stats-backdrop"
        aria-hidden="true"
    ></div>

    <!-- DASHBOARD PANEL -->
    <aside
        id="stats-panel"
        class="stats-panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="stats-title"
        aria-hidden="true"
        inert
    >
        <div class="stats-header">
            <h2 id="stats-title">Your Stats</h2>

            <button
                type="button"
                id="stats-close"
                class="stats-close"
                aria-label="Close dashboard"
            >
                &times;
            </button>
        </div>

        <div class="stats-content">
            <p>Days played: <span id="stats-days-played">0</span></p>
            <p>Current daily streak: <span id="stats-daily-streak">0</span></p>
            <p>
                Highest difficulty reached:{" "}
                <span id="stats-highest-difficulty">—</span>
            </p>
            <p>
                Total sessions played:{" "}
                <span id="stats-total-sessions">0</span>
            </p>
            <p>
                Estimated training time:{" "}
                <span id="stats-estimated-time">0m</span>
            </p>
        </div>

        <!-- FOOTER -->
        <footer class="stats-footer">
            <a href="/profile" class="profile-link">
                Edit profile
            </a>
        </footer>
    </aside>
</div>

<script>
    import { onAuthStateChanged } from "firebase/auth";
    import { auth, db } from "../firebase.js";
    import { doc, getDoc } from "firebase/firestore";

    // ELEMENTS

    const totalSessionsElement = document.querySelector<HTMLSpanElement>(
        "#stats-total-sessions"
    );

    const estimatedTimeElement = document.querySelector<HTMLSpanElement>(
        "#stats-estimated-time"
    );

    const daysPlayedElement = document.querySelector<HTMLSpanElement>(
        "#stats-days-played"
    );

    const dailyStreakElement = document.querySelector<HTMLSpanElement>(
        "#stats-daily-streak"
    );

    const highestDifficultyElement = document.querySelector<HTMLSpanElement>(
        "#stats-highest-difficulty"
    );

    const dashboard = document.querySelector<HTMLDivElement>(
        "#stats-dashboard"
    );

    const closeButton = document.querySelector<HTMLButtonElement>(
        "#stats-close"
    );

    const backdrop = document.querySelector<HTMLDivElement>(
        "#stats-backdrop"
    );

    const panel = document.querySelector<HTMLElement>(
        "#stats-panel"
    );

    const userInfo = document.querySelector<HTMLButtonElement>(
        "#user-info"
    );

    let previousFocus: HTMLElement | null = null;
    let previousBodyOverflow = "";

    // DAILY STREAK

    function calculateDailyStreak(
        creditedDays: Record<string, boolean>
    ): number {
        // Get today's date in Stockholm.
        const today = new Intl.DateTimeFormat("sv-SE", {
            timeZone: "Europe/Stockholm",
            year: "numeric",
            month: "2-digit",
            day: "2-digit",
        }).format(new Date());

        // Use UTC calendar arithmetic to avoid daylight saving issues.
        const date = new Date(`${today}T00:00:00Z`);

        function dateKey(): string {
            return date.toISOString().slice(0, 10);
        }

        // If today isn't credited, start checking from yesterday.
        if (!creditedDays[dateKey()]) {
            date.setUTCDate(date.getUTCDate() - 1);
        }

        let streak = 0;

        // Count consecutive credited days backwards.
        while (creditedDays[dateKey()]) {
            streak++;
            date.setUTCDate(date.getUTCDate() - 1);
        }

        return streak;
    }

    function getHighestDifficulty(
        games: Record<string, {
            level?: number;
            highestLevel?: number;
        }>
    ): string {
        let highest = -Infinity;
        let gameNames: string[] = [];

        for (const [slug, game] of Object.entries(games)) {
            if (!game || typeof game !== "object") continue;

            const level = game.highestLevel ?? game.level;

            if (typeof level !== "number" || !Number.isFinite(level)) {
                continue;
            }

            const gameName = slug
                .split("-")
                .map(word => word.charAt(0).toUpperCase() + word.slice(1))
                .join(" ");

            if (level > highest) {
                highest = level;
                gameNames = [gameName];
            } else if (level === highest) {
                gameNames.push(gameName);
            }
        }

        if (gameNames.length === 0) {
            return "—";
        }

        return `${highest} — ${gameNames.join(", ")}`;
    }

    // COMPLETED SESSIONS

    function countCompletedSessions(
        completedSessions: Record<string, Record<string, boolean>>
    ): number {
        let total = 0;

        for (const games of Object.values(completedSessions)) {
            for (const completed of Object.values(games)) {
                if (completed === true) {
                    total++;
                }
            }
        }

        return total;
    }

    // ESTIMATED TRAINING TIME

    function formatEstimatedTime(sessions: number): string {
        const totalMinutes = sessions * 5;

        const hours = Math.floor(totalMinutes / 60);
        const minutes = totalMinutes % 60;

        if (hours === 0) {
            return `${minutes}m`;
        }

        if (minutes === 0) {
            return `${hours}h`;
        }

        return `${hours}h ${minutes}m`;
    }

    // AUTHENTICATION

    onAuthStateChanged(auth, async (user) => {
        if (!user) {
            closeDashboard();

            if (totalSessionsElement) {
                totalSessionsElement.textContent = "0";
            }

            if (estimatedTimeElement) {
                estimatedTimeElement.textContent = "0m";
            }

            if (daysPlayedElement) {
                daysPlayedElement.textContent = "0";
            }

            if (dailyStreakElement) {
                dailyStreakElement.textContent = "0";
            }

            if (highestDifficultyElement) {
                highestDifficultyElement.textContent = "—";
            }

            return;
        }

        try {
            const snapshot = await getDoc(
                doc(db, "gameSaves", user.uid)
            );

            if (auth.currentUser?.uid !== user.uid) return;

            const data = snapshot.exists() ? snapshot.data() : {};

            // DAYS PLAYED
            const daysPlayed = data.daysPlayed ?? 0;

            if (daysPlayedElement) {
                daysPlayedElement.textContent = String(daysPlayed);
            }

            // DAILY STREAK
            const creditedDays = data.creditedDays ?? {};
            const dailyStreak = calculateDailyStreak(creditedDays);

            if (dailyStreakElement) {
                dailyStreakElement.textContent = String(dailyStreak);
            }

            // HIGHEST DIFFICULTY
            const games = data.games ?? {};
            const highestDifficulty = getHighestDifficulty(games);

            if (highestDifficultyElement) {
                highestDifficultyElement.textContent = highestDifficulty;
            }

            // COMPLETED SESSIONS AND ESTIMATED TIME

            const completedSessions = data.completedSessions ?? {};
            const totalSessions = countCompletedSessions(completedSessions);
            const estimatedTime = formatEstimatedTime(totalSessions);

            if (totalSessionsElement) {
                totalSessionsElement.textContent = String(totalSessions);
            }

            if (estimatedTimeElement) {
                estimatedTimeElement.textContent = estimatedTime;
            }
        } catch (error) {
            console.error("Could not load stats:", error);

            if (auth.currentUser?.uid === user.uid) {
                if (totalSessionsElement) {
                    totalSessionsElement.textContent = "Unavailable";
                }

                if (estimatedTimeElement) {
                    estimatedTimeElement.textContent = "Unavailable";
                }

                if (daysPlayedElement) {
                    daysPlayedElement.textContent = "Unavailable";
                }

                if (dailyStreakElement) {
                    dailyStreakElement.textContent = "Unavailable";
                }

                if (highestDifficultyElement) {
                    highestDifficultyElement.textContent = "Unavailable";
                }
            }
        }
    });

    // OPEN

    function openDashboard() {
        if (
            !auth.currentUser ||
            !dashboard ||
            !panel ||
            dashboard.classList.contains("is-open")
        ) return;

        previousFocus = document.activeElement as HTMLElement;
        previousBodyOverflow = document.body.style.overflow;

        dashboard.classList.add("is-open");

        panel.inert = false;
        panel.setAttribute("aria-hidden", "false");
        userInfo?.setAttribute("aria-expanded", "true");

        document.body.style.overflow = "hidden";

        closeButton?.focus();
    }

    // CLOSE

    function closeDashboard() {
        if (!dashboard || !panel) return;

        const wasOpen = dashboard.classList.contains("is-open");

        dashboard.classList.remove("is-open");

        if (wasOpen && panel.contains(document.activeElement)) {
            previousFocus?.focus();
        }

        panel.inert = true;
        panel.setAttribute("aria-hidden", "true");
        userInfo?.setAttribute("aria-expanded", "false");

        if (wasOpen) {
            document.body.style.overflow = previousBodyOverflow;
        }
    }

    // HEADER EVENT

    document.addEventListener(
        "sharper:open-stats",
        openDashboard
    );

    // CLOSE EVENTS

    closeButton?.addEventListener("click", closeDashboard);

    backdrop?.addEventListener("click", closeDashboard);

    // KEYBOARD SUPPORT

    document.addEventListener("keydown", (event) => {
        if (!dashboard?.classList.contains("is-open") || !panel) {
            return;
        }

        if (event.key === "Escape") {
            event.preventDefault();
            closeDashboard();
            return;
        }

        if (event.key !== "Tab") return;

        const focusable = Array.from(
            panel.querySelectorAll<HTMLElement>(
                'button:not([disabled]), a[href], input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
            )
        ).filter((element) => !element.hidden);

        if (focusable.length === 0) {
            event.preventDefault();
            return;
        }

        const first = focusable[0];
        const last = focusable[focusable.length - 1];

        if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
        } else if (
            !event.shiftKey &&
            document.activeElement === last
        ) {
            event.preventDefault();
            first.focus();
        }
    });
</script>

<style>
    /* BACKDROP */

    .stats-backdrop {
        position: fixed;
        inset: 0;
        z-index: 999;

        background-color: rgba(0, 0, 0, 0.45);

        opacity: 0;
        visibility: hidden;
        pointer-events: none;

        transition:
            opacity 0.25s ease,
            visibility 0.25s ease;
    }

    .is-open .stats-backdrop {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    /* SIDEBAR */

    .stats-panel {
        position: fixed;
        top: 0;
        bottom: 0;
        left: 0;
        z-index: 1000;

        width: 340px;
        max-width: 100%;

        display: flex;
        flex-direction: column;

        background-color: white;
        color: #222;

        box-shadow: 4px 0 20px rgba(0, 0, 0, 0.15);

        transform: translateX(-100%);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;

        transition:
            transform 0.25s ease,
            opacity 0.25s ease,
            visibility 0.25s ease;
    }

    .is-open .stats-panel {
        transform: translateX(0);
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
    }

    /* HEADER */

    .stats-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;

        padding: 1rem;
        border-bottom: 1px solid #ddd;
    }

    .stats-header h2 {
        margin: 0;
        font-size: 1.5rem;
    }

    .stats-close {
        display: flex;
        align-items: center;
        justify-content: center;

        width: 40px;
        height: 40px;

        border: none;
        border-radius: 8px;
        background: transparent;
        color: inherit;

        font-size: 2rem;
        cursor: pointer;
    }

    .stats-close:hover {
        background-color: #f0f0f0;
    }

    .stats-close:focus-visible,
    .profile-link:focus-visible {
        outline: 3px solid var(--theme-color);
        outline-offset: 3px;
    }

    /* CONTENT */

    .stats-content {
        flex: 1;
        min-height: 0;

        padding: 1rem;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .stats-section {
        margin-bottom: 1.5rem;
    }

    .stats-section h3 {
        margin: 0 0 0.75rem;
        font-size: 1rem;
    }

    .stats-placeholder {
        min-height: 100px;
        border: 2px dashed #ddd;
        border-radius: 8px;
        background-color: #fafafa;
    }

    /* FOOTER */

    .stats-footer {
        padding: 1rem;
        border-top: 1px solid #ddd;
        text-align: center;
    }

    .profile-link {
        color: #666;
        font-size: 0.875rem;
        text-decoration: none;
    }

    .profile-link:hover {
        color: var(--theme-color);
        text-decoration: underline;
    }

    /* MOBILE */

    @media (max-width: 600px) {
        .stats-panel {
            width: 100%;
            height: 100dvh;
            bottom: auto;

            transform: translateX(-20px);
        }

        .is-open .stats-panel {
            transform: translateX(0);
        }

        .stats-header,
        .stats-content {
            padding: 1.25rem;
        }
    }

    /* REDUCED MOTION */

    @media (prefers-reduced-motion: reduce) {
        .stats-backdrop,
        .stats-panel {
            transition: none;
        }
    }
</style>