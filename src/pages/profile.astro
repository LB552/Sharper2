---
import Layout from "../layouts/Layout.astro";
import "../styles/forms.css";
---

<Layout>
    <main class="form-page">
        <h1>Profile</h1>

        <p id="profile-message" role="status" aria-live="polite">
            Loading profile...
        </p>

        <div id="profile-content" class="form-grid" hidden>
            <!-- USERNAME -->
            <section class="form-card">
                <h2>Change username</h2>

                <p class="current-value">
                    Current username:{" "}
                    <span id="current-username"></span>
                </p>

                <form id="username-form">
                    <input
                        type="text"
                        id="new-username"
                        placeholder="New username"
                        aria-label="New username"
                        autocomplete="off"
                        minlength="3"
                        maxlength="20"
                        pattern="[A-Za-z0-9_]+"
                        title="Use 3–20 letters, numbers, or underscores."
                        required
                    >

                    <input
                        type="text"
                        id="confirm-username"
                        placeholder="Repeat new username"
                        aria-label="Repeat new username"
                        autocomplete="off"
                        minlength="3"
                        maxlength="20"
                        pattern="[A-Za-z0-9_]+"
                        required
                    >

                    <button type="submit">Change username</button>

                    <p id="username-message" role="status" aria-live="polite"></p>
                </form>
            </section>

            <!-- EMAIL -->
            <section class="form-card">
                <h2>Change email</h2>

                <p class="current-value">
                    Current email:{" "}
                    <span id="current-email"></span>
                </p>

                <form id="email-form">
                    <input
                        type="email"
                        id="new-email"
                        placeholder="New email"
                        aria-label="New email"
                        autocomplete="email"
                        required
                    >

                    <input
                        type="email"
                        id="confirm-email"
                        placeholder="Repeat new email"
                        aria-label="Repeat new email"
                        autocomplete="off"
                        required
                    >

                    <button type="submit">Change email</button>

                    <p id="email-message" role="status" aria-live="polite"></p>
                </form>
            </section>

            <!-- PASSWORD -->
            <section class="form-card">
                <h2>Change password</h2>

                <form id="password-form">
                    <input
                        type="password"
                        id="current-password"
                        placeholder="Current password"
                        aria-label="Current password"
                        autocomplete="current-password"
                        required
                    >

                    <input
                        type="password"
                        id="new-password"
                        placeholder="New password"
                        aria-label="New password"
                        autocomplete="new-password"
                        minlength="6"
                        required
                    >

                    <input
                        type="password"
                        id="confirm-password"
                        placeholder="Repeat new password"
                        aria-label="Repeat new password"
                        autocomplete="new-password"
                        minlength="6"
                        required
                    >

                    <button type="submit">Change password</button>

                    <p id="password-message" role="status" aria-live="polite"></p>
                </form>
            </section>
        </div>

        <!-- ACCOUNT DELETION -->
        <section id="danger-zone" class="form-card" hidden>
            <h2>Danger zone</h2>

            <p>
                Permanently delete your Sharper account and all
                associated progress. This action cannot be undone.
            </p>

            <button
                id="delete-account-button"
                type="button"
            >
                Delete account
            </button>
        </section>

        <!-- DELETE CONFIRMATION -->
        <dialog
            id="delete-account-dialog"
            aria-labelledby="delete-dialog-title"
        >
            <div class="delete-dialog-content">
                <h2 id="delete-dialog-title">Delete your account?</h2>

                <p>
                    This will permanently delete your account,
                    saved game progress, and training history.
                    This action cannot be undone.
                </p>

                <form id="delete-account-form">
                    <label for="delete-password">
                        Current password
                    </label>
                    <input
                        id="delete-password"
                        type="password"
                        autocomplete="current-password"
                        required
                    >

                    <label for="delete-confirmation">
                        Type DELETE to confirm
                    </label>
                    <input
                        id="delete-confirmation"
                        type="text"
                        autocomplete="off"
                        required
                    >

                    <p
                        id="delete-account-message"
                        role="status"
                        aria-live="polite"
                    ></p>

                    <div class="delete-dialog-actions">
                        <button
                            id="cancel-delete-button"
                            type="button"
                        >
                            Cancel
                        </button>

                        <button
                            id="confirm-delete-button"
                            type="submit"
                            disabled
                        >
                            Delete permanently
                        </button>
                    </div>
                </form>
            </div>
        </dialog>
    </main>
</Layout>

<script>
    import { auth, db } from "../firebase.js";
    import {
        onAuthStateChanged,
        updateEmail,
        updatePassword,
        EmailAuthProvider,
        reauthenticateWithCredential,
        deleteUser,
    } from "firebase/auth";
    import {
        doc,
        getDoc,
        updateDoc,
        writeBatch,
    } from "firebase/firestore";
    import { FirebaseError } from "firebase/app";

    // ELEMENTS

    const currentPassword = document.querySelector<HTMLInputElement>(
        "#current-password"
    );

    const profileMessage = document.querySelector<HTMLParagraphElement>(
        "#profile-message"
    );

    const profileContent = document.querySelector<HTMLDivElement>(
        "#profile-content"
    );

    const currentUsername = document.querySelector<HTMLSpanElement>(
        "#current-username"
    );

    const currentEmail = document.querySelector<HTMLSpanElement>(
        "#current-email"
    );

    const usernameForm = document.querySelector<HTMLFormElement>(
        "#username-form"
    );

    const newUsername = document.querySelector<HTMLInputElement>(
        "#new-username"
    );

    const confirmUsername = document.querySelector<HTMLInputElement>(
        "#confirm-username"
    );

    const usernameMessage = document.querySelector<HTMLParagraphElement>(
        "#username-message"
    );

    const emailForm = document.querySelector<HTMLFormElement>(
        "#email-form"
    );

    const newEmail = document.querySelector<HTMLInputElement>(
        "#new-email"
    );

    const confirmEmail = document.querySelector<HTMLInputElement>(
        "#confirm-email"
    );

    const emailMessage = document.querySelector<HTMLParagraphElement>(
        "#email-message"
    );

    const passwordForm = document.querySelector<HTMLFormElement>(
        "#password-form"
    );

    const newPassword = document.querySelector<HTMLInputElement>(
        "#new-password"
    );

    const confirmPassword = document.querySelector<HTMLInputElement>(
        "#confirm-password"
    );

    const passwordMessage = document.querySelector<HTMLParagraphElement>(
        "#password-message"
    );

    // ERROR HANDLING

    function getErrorMessage(error: unknown): string {
        if (error instanceof FirebaseError) {
            console.error("Profile error:", error.code);

            switch (error.code) {
                case "auth/requires-recent-login":
                    return "Please log out and log in again before changing this.";

                case "auth/email-already-in-use":
                    return "This email is already registered.";

                case "auth/invalid-email":
                    return "Please enter a valid email.";

                case "auth/weak-password":
                    return "Choose a stronger password.";

                case "auth/operation-not-allowed":
                    return "This change is not allowed by Firebase.";

                case "permission-denied":
                    return "Firestore permission denied.";
            }
        }

        return "Something went wrong. Please try again.";
    }

    // LOAD PROFILE

    onAuthStateChanged(auth, async (user) => {
        if (profileContent) {
            profileContent.hidden = true;
        }

        if (dangerZone) {
            dangerZone.hidden = true;
        }

        if (!user) {
            window.location.href = "/login";
            return;
        }

        try {
            const snapshot = await getDoc(doc(db, "users", user.uid));

            if (auth.currentUser?.uid !== user.uid) return;

            if (currentUsername) {
                currentUsername.textContent = snapshot.exists()
                    ? snapshot.data().username ?? ""
                    : "";
            }

            if (currentEmail) {
                currentEmail.textContent = user.email ?? "";
            }

            if (profileContent) {
                profileContent.hidden = false;
            }

            if (dangerZone) {
                dangerZone.hidden = false;
            }

            if (profileMessage) {
                profileMessage.textContent = "";
            }
        } catch (error) {
            if (profileMessage) {
                profileMessage.textContent = getErrorMessage(error);
            }
        }
    });

    // CHANGE USERNAME

    usernameForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        const user = auth.currentUser;

        if (
            !user ||
            !newUsername ||
            !confirmUsername ||
            !usernameMessage
        ) return;

        const username = newUsername.value.trim();

        if (username !== confirmUsername.value.trim()) {
            usernameMessage.textContent = "Usernames do not match.";
            return;
        }

        if (!/^[A-Za-z0-9_]{3,20}$/.test(username)) {
            usernameMessage.textContent =
                "Use 3–20 letters, numbers, or underscores.";
            return;
        }

        usernameMessage.textContent = "Updating username...";

        try {
            await updateDoc(doc(db, "users", user.uid), {
                username,
                usernameLower: username.toLowerCase(),
            });

            if (currentUsername) {
                currentUsername.textContent = username;
            }

            usernameForm.reset();
            usernameMessage.textContent = "Username updated successfully.";
        } catch (error) {
            usernameMessage.textContent = getErrorMessage(error);
        }
    });

    // CHANGE EMAIL

    emailForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        const user = auth.currentUser;

        if (
            !user ||
            !newEmail ||
            !confirmEmail ||
            !emailMessage
        ) return;

        const email = newEmail.value.trim();

        if (email !== confirmEmail.value.trim()) {
            emailMessage.textContent = "Email addresses do not match.";
            return;
        }

        if (email === user.email) {
            emailMessage.textContent =
                "This is already your current email.";
            return;
        }

        emailMessage.textContent = "Updating email...";

        try {
            // Update Firebase Authentication.
            await updateEmail(user, email);

            // Keep the Firestore profile in sync.
            try {
                await updateDoc(doc(db, "users", user.uid), {
                    email,
                });
            } catch (firestoreError) {
                console.error(
                    "Email changed in Auth, but Firestore sync failed:",
                    firestoreError
                );

                if (currentEmail) {
                    currentEmail.textContent = email;
                }

                emailMessage.textContent =
                    "Email changed, but the profile record could not be updated.";
                return;
            }

            if (currentEmail) {
                currentEmail.textContent = email;
            }

            emailForm.reset();
            emailMessage.textContent = "Email updated successfully.";
        } catch (error) {
            emailMessage.textContent = getErrorMessage(error);
        }
    });


    // CHANGE PASSWORD

    passwordForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        const user = auth.currentUser;

        if (
            !user ||
            !currentPassword ||
            !newPassword ||
            !confirmPassword ||
            !passwordMessage
        ) return;

        if (newPassword.value !== confirmPassword.value) {
            passwordMessage.textContent = "Passwords do not match.";
            return;
        }

        passwordMessage.textContent = "Updating password...";

        try {
            // Verify the user's current password.
            const credential = EmailAuthProvider.credential(
                user.email!,
                currentPassword.value
            );

            await reauthenticateWithCredential(user, credential);

            // Update the password after successful verification.
            await updatePassword(user, newPassword.value);

            passwordForm.reset();

            passwordMessage.textContent =
                "Password updated successfully.";
        } catch (error) {
            if (
                error instanceof FirebaseError &&
                (
                    error.code === "auth/wrong-password" ||
                    error.code === "auth/invalid-credential"
                )
            ) {
                passwordMessage.textContent =
                    "Current password is incorrect.";
            } else {
                passwordMessage.textContent = getErrorMessage(error);
            }
        }
    });

    // DELETE ACCOUNT

    const dangerZone = document.querySelector<HTMLElement>(
        "#danger-zone"
    );

    const deleteAccountButton = document.querySelector<HTMLButtonElement>(
        "#delete-account-button"
    );

    const deleteDialog = document.querySelector<HTMLDialogElement>(
        "#delete-account-dialog"
    );

    const deleteForm = document.querySelector<HTMLFormElement>(
        "#delete-account-form"
    );

    const deletePassword = document.querySelector<HTMLInputElement>(
        "#delete-password"
    );

    const deleteConfirmation = document.querySelector<HTMLInputElement>(
        "#delete-confirmation"
    );

    const deleteMessage = document.querySelector<HTMLParagraphElement>(
        "#delete-account-message"
    );

    const confirmDeleteButton = document.querySelector<HTMLButtonElement>(
        "#confirm-delete-button"
    );

    const cancelDeleteButton = document.querySelector<HTMLButtonElement>(
        "#cancel-delete-button"
    );

    let deletingAccount = false;

    // Enable confirmation only when DELETE is typed.

    deleteConfirmation?.addEventListener("input", () => {
        if (!confirmDeleteButton || !deleteConfirmation) return;

        confirmDeleteButton.disabled =
            deleteConfirmation.value !== "DELETE";
    });

    // Open confirmation dialog.

    deleteAccountButton?.addEventListener("click", () => {
        if (!deleteDialog || !deleteForm || !deleteMessage) return;

        deleteForm.reset();
        deleteMessage.textContent = "";

        if (confirmDeleteButton) {
            confirmDeleteButton.disabled = true;
        }

        deleteDialog.showModal();
    });

    // Cancel deletion.

    cancelDeleteButton?.addEventListener("click", () => {
        if (!deletingAccount) {
            deleteDialog?.close();
        }
    });

    deleteDialog?.addEventListener("cancel", (event) => {
        if (deletingAccount) {
            event.preventDefault();
        }
    });

    // Perform account deletion.

    deleteForm?.addEventListener("submit", async (event) => {
        event.preventDefault();

        const user = auth.currentUser;

        if (
            !user ||
            !user.email ||
            !deletePassword ||
            !deleteConfirmation ||
            !deleteMessage ||
            !confirmDeleteButton ||
            !cancelDeleteButton
        ) return;

        if (deletingAccount) return;

        if (deleteConfirmation.value !== "DELETE") {
            deleteMessage.textContent =
                "Type DELETE to confirm.";
            return;
        }

        deletingAccount = true;
        confirmDeleteButton.disabled = true;
        cancelDeleteButton.disabled = true;

        deleteMessage.textContent = "Deleting account...";

        let firestoreDeleted = false;

        try {
            // Verify the user's current password.

            const credential = EmailAuthProvider.credential(
                user.email,
                deletePassword.value
            );

            await reauthenticateWithCredential(user, credential);

            // Delete all three Firestore documents together.

            const batch = writeBatch(db);

            batch.delete(doc(db, "users", user.uid));
            batch.delete(doc(db, "gameSaves", user.uid));
            batch.delete(doc(db, "gameTimeLimits", user.uid));

            await batch.commit();

            firestoreDeleted = true;

            // Delete the Firebase Authentication account.

            await deleteUser(user);

            // Return to the index page.

            window.location.replace("/");

        } catch (error) {
            if (firestoreDeleted) {
                deleteMessage.textContent =
                    "Your saved data was deleted, but the account " +
                    "could not be removed. Please try again or " +
                    "contact support.";
            } else if (
                error instanceof FirebaseError &&
                (
                    error.code === "auth/wrong-password" ||
                    error.code === "auth/invalid-credential"
                )
            ) {
                deleteMessage.textContent =
                    "Current password is incorrect.";
            } else {
                deleteMessage.textContent =
                    getErrorMessage(error);
            }

            console.error("Account deletion error:", error);

        } finally {
            deletingAccount = false;
            cancelDeleteButton.disabled = false;

            confirmDeleteButton.disabled =
                deleteConfirmation.value !== "DELETE";
        }
    });
</script>

<style>
    /* DANGER ZONE */

    #danger-zone {
        max-width: 1100px;
        margin: calc(var(--spacing-unit) * 2) auto 0;
    }

    #danger-zone[hidden] {
        display: none !important;
    }

    #danger-zone h2 {
        color: var(--danger-color, #dc2626);
    }

    #danger-zone p {
        color: var(--muted-text-color);
        line-height: 1.5;
    }

    #delete-account-button,
    #confirm-delete-button {
        padding: 0.75rem 1.5rem;
        border: 2px solid var(--danger-color, #dc2626);
        border-radius: var(--border-radius);
        background: var(--danger-color, #dc2626);
        color: white;
        font-family: var(--default-font);
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
    }

    #delete-account-button:hover,
    #confirm-delete-button:hover:not(:disabled) {
        background: #b91c1c;
        border-color: #b91c1c;
    }

    /* CONFIRMATION DIALOG */

    #delete-account-dialog {
        width: min(90vw, 440px);
        max-height: 90vh;
        box-sizing: border-box;
        padding: 0;
        border: none;
        border-radius: var(--border-radius);
        background: var(--background-color);
        color: var(--text-color);
        font-family: var(--default-font);
        box-shadow: 0 16px 48px rgb(0 0 0 / 0.15);
    }

    #delete-account-dialog::backdrop {
        background: rgb(0 0 0 / 0.5);
    }

    .delete-dialog-content {
        padding: calc(var(--spacing-unit) * 1.5);
    }

    .delete-dialog-content h2 {
        margin: 0 0 var(--spacing-unit);
        color: var(--danger-color, #dc2626);
    }

    .delete-dialog-content p {
        line-height: 1.5;
    }

    #delete-account-form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    #delete-account-form label {
        font-weight: 600;
    }

    #delete-account-form input {
        box-sizing: border-box;
        width: 100%;
        padding: 0.75rem;
        border: 1px solid #ccc;
        border-radius: var(--border-radius);
        background: var(--background-color);
        color: var(--text-color);
        font: inherit;
    }

    .delete-dialog-actions {
        display: flex;
        gap: var(--spacing-unit);
        margin-top: var(--spacing-unit);
    }

    .delete-dialog-actions button {
        flex: 1;
    }

    #cancel-delete-button {
        padding: 0.75rem 1rem;
        border: 2px solid var(--theme-color);
        border-radius: var(--border-radius);
        background: transparent;
        color: var(--theme-color);
        font: inherit;
        font-weight: 600;
        cursor: pointer;
    }

    #confirm-delete-button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    #delete-account-button:focus-visible,
    #confirm-delete-button:focus-visible,
    #cancel-delete-button:focus-visible {
        outline: 3px solid var(--theme-color);
        outline-offset: 3px;
    }

    @media (min-width: 1000px) {
        .form-page {
            max-width: 1100px;
        }

        .form-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
</style>