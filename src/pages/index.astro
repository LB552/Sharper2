---
import { sanityClient } from "sanity:client";
import Layout from "../layouts/Layout.astro";
import StatsDashboard from "../components/StatsDashboard.astro";

const games = await sanityClient.fetch(`
    *[_type == "game" && defined(slug.current)] {
        title,
        subheading,
        "slug": slug.current,
        "thumbnailUrl": thumbnail.asset->url,
        unlockRequirement
    }
`);
---

<Layout title="Sharper">
    <StatsDashboard />

	<h1>Games</h1>

    <div class="game-grid" id="game-grid" aria-busy="true">
        {games.map((game) => (
            <a
                class="game-card"
                data-game-slug={game.slug}
                data-unlock-requirement={game.unlockRequirement ?? 0}
                data-game-href={`/${game.slug}`}
                data-thumbnail-url={game.thumbnailUrl ?? ""}
            >
                <img
                    class="game-thumbnail"
                    src={game.thumbnailUrl || "/lock.png"}
                    alt={game.title}
                    loading="lazy"
                />

                <div class="game-info">
                    <h3>{game.title}</h3>

                    {game.subheading && <p>{game.subheading}</p>}

                    <p class="game-difficulty">Difficulty: ...</p>
                    <p class="unlock-requirement" hidden></p>
                </div>
            </a>
        ))}
    </div>
</Layout>

<script>
    import { waitForAuth, loadDifficulty } from "../utils/gameProgress.js";
    import { isGameLocked } from "../utils/demoMode.js";
    import { loadDaysPlayed, isUnlocked } from "../utils/daysPlayed.js";

    async function initializeCards() {
        const grid = document.querySelector<HTMLElement>("#game-grid")!;
        const cards = Array.from(grid.querySelectorAll<HTMLAnchorElement>(".game-card"));

        try {
            const user = await waitForAuth();
            const daysPlayed = user ? await loadDaysPlayed(user) : 0;

            await Promise.all(cards.map(async (card) => {
                const slug = card.dataset.gameSlug ?? "";
                const image = card.querySelector<HTMLImageElement>(".game-thumbnail")!;
                const difficultyLabel = card.querySelector<HTMLElement>(".game-difficulty")!;
                const requirement = card.querySelector<HTMLElement>(".unlock-requirement")!;

                const threshold = Number(card.dataset.unlockRequirement ?? 0);
                const guestLocked = isGameLocked(slug, user);
                const daysLocked = !guestLocked && !!user && !isUnlocked(daysPlayed, threshold);

                if (guestLocked || daysLocked) {
                    card.removeAttribute("href");
                    card.setAttribute("aria-disabled", "true");
                    card.classList.add("is-locked");
                    image.src = "/lock.png";
                    image.alt = `${slug} is locked`;
                    difficultyLabel.hidden = true;
                    requirement.textContent = guestLocked
                        ? "Create an account to unlock"
                        : `Unlock after ${threshold} training days (${daysPlayed}/${threshold})`;
                    requirement.hidden = false;
                    return;
                }

                card.href = card.dataset.gameHref ?? "#";
                card.removeAttribute("aria-disabled");
                card.classList.remove("is-locked");
                const originalThumbnail = card.dataset.thumbnailUrl;
                if (originalThumbnail) image.src = originalThumbnail;
                image.alt = slug;
                difficultyLabel.hidden = false;
                requirement.hidden = true;

                try {
                    const difficulty = await loadDifficulty(slug, user);
                    difficultyLabel.textContent = `Difficulty: ${difficulty}`;
                } catch (error) {
                    console.error(`Could not load ${slug} difficulty:`, error);
                    difficultyLabel.textContent = "Difficulty: unavailable";
                }
            }));
        } catch (error) {
            console.error("Could not determine authentication state:", error);
            // Leave all cards non-navigable until authentication is known.
            cards.forEach(card => {
                const difficulty = card.querySelector<HTMLElement>(".game-difficulty");
                if (difficulty) difficulty.textContent = "Games temporarily unavailable";
            });
        } finally {
            grid.dataset.ready = "true";
            grid.setAttribute("aria-busy", "false");
        }
    }

    void initializeCards();
</script>

<style>
    h1 {
        margin-bottom: 2rem;
        text-align: center;
        color: var(--theme-color);
    }

    .game-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1rem 3rem;
    }

    .game-grid:not([data-ready]) {
        visibility: hidden;
    }

    .game-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        border: 2px solid transparent;
        border-radius: 14px;
        background: #f5f6fa;
        color: #222;
        text-decoration: none;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .game-card[href]:hover {
        transform: translateY(-4px);
        border-color: var(--theme-color);
    }

    .game-card:focus-visible {
        outline: 3px solid var(--theme-color);
        outline-offset: 3px;
    }

    .game-card.is-locked {
        cursor: not-allowed;
    }

    .game-thumbnail {
        display: block;
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
    }

    .game-info {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1rem;
    }

    .game-info h3 {
        margin: 0;
        color: var(--theme-color);
        font-size: 1.125rem;
    }

    .game-info p {
        margin: 0;
        color: #666;
        font-size: 0.875rem;
        line-height: 1.5;
    }

    .game-info .game-difficulty,
    .game-info .unlock-requirement {
        margin-top: auto;
        padding-top: 0.75rem;
        font-weight: 600;
        color: var(--theme-color);
    }

    .game-info [hidden] {
        display: none;
    }

    @media (min-width: 600px) {
        .game-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.25rem;
            padding-inline: 1.5rem;
        }
    }

    @media (min-width: 900px) {
        .game-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1.5rem;
            padding-inline: 2rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .game-card { transition: none; }
        .game-card[href]:hover { transform: none; }
    }
</style>