---
import { sanityClient } from "sanity:client";
import Layout from "../layouts/Layout.astro";

const games = await sanityClient.fetch(`
    *[_type == "game" && defined(slug.current)] {
        title,
        subheading,
        "slug": slug.current,
        "thumbnailUrl": thumbnail.asset->url
    }
`);
---

<Layout title="Sharper">
    <h1>Sharper</h1>

    <div class="game-grid">
        {games.map((game) => (
            <a
                class="game-card"
                href={`/${game.slug}`}
                data-game-slug={game.slug}
            >
                {game.thumbnailUrl ? (
                    <img
                        src={game.thumbnailUrl}
                        alt={game.title}
                        loading="lazy"
                    />
                ) : (
                    <div class="thumbnail-placeholder">
                        No thumbnail yet
                    </div>
                )}

                <div class="game-info">
                    <h3>{game.title}</h3>

                    {game.subheading && (
                        <p>{game.subheading}</p>
                    )}

                    <p class="game-difficulty">
                        Difficulty: ...
                    </p>
                </div>
            </a>
        ))}
    </div>
</Layout>

<script>
    import {
        waitForAuth,
        loadDifficulty,
    } from "../utils/gameProgress.js";

    async function displayDifficulties() {
        const gameCards = document.querySelectorAll<HTMLElement>(
            ".game-card"
        );

        try {
            const user = await waitForAuth();

            await Promise.all(
                Array.from(gameCards, async (card) => {
                    const gameSlug = card.dataset.gameSlug;
                    const difficultyElement = card.querySelector(
                        ".game-difficulty"
                    );

                    if (!gameSlug || !difficultyElement) return;

                    try {
                        const difficulty = await loadDifficulty(
                            gameSlug,
                            user
                        );

                        difficultyElement.textContent =
                            `Difficulty: ${difficulty}`;
                    } catch (error) {
                        console.error(
                            `Failed to load difficulty for ${gameSlug}:`,
                            error
                        );

                        difficultyElement.textContent =
                            "Difficulty: unavailable";
                    }
                })
            );
        } catch (error) {
            console.error("Failed to determine authentication:", error);

            gameCards.forEach((card) => {
                const element = card.querySelector(".game-difficulty");

                if (element) {
                    element.textContent = "Difficulty: unavailable";
                }
            });
        }
    }

    displayDifficulties();
</script>

<style>
    h1 {
        margin-bottom: 2rem;
        text-align: center;
        color: var(--theme-color);
    }

    .game-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1rem;
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 0 1rem 3rem;
    }

    .game-card {
        display: flex;
        flex-direction: column;
        min-width: 0;
        overflow: hidden;
        border: 2px solid transparent;
        border-radius: 14px;
        background-color: #f5f6fa;
        color: #222;
        text-decoration: none;
        transition:
            transform 0.2s ease,
            border-color 0.2s ease,
            box-shadow 0.2s ease;
    }

    .game-card:hover {
        transform: translateY(-4px);
        border-color: var(--theme-color);
        box-shadow: 0 6px 18px rgba(0, 0, 0, 0.1);
    }

    .game-card:focus-visible {
        outline: 3px solid var(--theme-color);
        outline-offset: 3px;
    }

    .game-card img,
    .thumbnail-placeholder {
        display: block;
        width: 100%;
        aspect-ratio: 1 / 1;
        object-fit: cover;
    }

    .thumbnail-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background-color: #e5e9f5;
        color: #777;
        text-align: center;
        font-size: 0.875rem;
    }

    .game-info {
        display: flex;
        flex: 1;
        flex-direction: column;
        gap: 0.5rem;
        padding: 1rem;
    }

    .game-info h3 {
        margin: 0;
        color: var(--theme-color);
        font-size: 1.125rem;
        line-height: 1.3;
    }

    .game-info p {
        margin: 0;
        color: #666;
        font-size: 0.875rem;
        line-height: 1.5;
    }

    .game-info .game-difficulty {
        margin-top: auto;
        padding-top: 0.75rem;
        color: var(--theme-color);
        font-weight: 600;
    }

    /* Tablets */
    @media (min-width: 600px) {
        .game-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 1.25rem;
            padding-inline: 1.5rem;
        }

        .game-info {
            padding: 1.25rem;
        }
    }

    /* Desktops */
    @media (min-width: 900px) {
        .game-grid {
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 1.5rem;
            padding-inline: 2rem;
        }
    }

    /* Respect reduced-motion preferences */
    @media (prefers-reduced-motion: reduce) {
        .game-card {
            transition: none;
        }

        .game-card:hover {
            transform: none;
        }
    }
</style>