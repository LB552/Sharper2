---
import { sanityClient } from 'sanity:client';

import Layout from '../layouts/Layout.astro';
import MemoryGame from '../games/Memory.astro';
import LightsGame from '../games/Lights.astro';

export async function getStaticPaths() {
    const games = await sanityClient.fetch(`
        *[_type == "game" && defined(slug.current)] {
            "slug": slug.current,
            title,
            description,
            gameType
        }
    `);

    return games.map((game) => ({
        params: { slug: game.slug },
        props: { game },
    }));
}

const { game } = Astro.props;
const GameComponent = {
    memory: MemoryGame,
    lights: LightsGame,
}[game.slug];
---

<Layout title={game.title}>
    <h1>{game.title}</h1>
    <p>{game.description}</p>

    <section class="game-window">
        {GameComponent && <GameComponent gameType={game.gameType} gameSlug={game.slug} />}
    </section>
</Layout>

<style>
    .game-window {
        width: 90%;
        margin-top: 1rem;
        margin-inline: auto;
        padding: 1rem;
        border-radius: 12px;
        background: darkgrey;
    }
</style>