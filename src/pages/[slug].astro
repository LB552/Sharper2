---
import { sanityClient } from 'sanity:client';

import Layout from '../layouts/Layout.astro';
import MemoryGame from '../games/Memory.astro';
import LightsGame from '../games/Lights.astro';
import WordsGame from '../games/Words.astro';
import CupsGame from "../games/Cups.astro";

export async function getStaticPaths() {
    const games = await sanityClient.fetch(`
        *[_type == "game" && defined(slug.current)] {
            "slug": slug.current,
            title,
            description,
            gameType,
            unlockRequirement
        }
    `);

    return games.map((game) => ({
        params: { slug: game.slug },
        props: { game },
    }));
}

const { game } = Astro.props;
const GameComponent = {
    memory: MemoryGame,
    lights: LightsGame,
    words: WordsGame,
    cups: CupsGame,
}[game.slug];
---

<Layout title={game.title}>
    <main class="game-page">
        <header class="game-intro">
            <h1>{game.title}</h1>
            {game.description && <p>{game.description}</p>}
        </header>

        <section class="game-window" aria-label={`${game.title} gameplay`}>
            {GameComponent && (
                <GameComponent
                    gameTitle={game.title}
                    gameType={game.gameType}
                    gameSlug={game.slug}
                    unlockRequirement={game.unlockRequirement ?? 0}
                />
            )}
        </section>
    </main>
</Layout>

<style>
    .game-page {
        width: min(100% - 2 * var(--spacing-unit), 900px);
        margin: 0 auto;
        padding: calc(var(--spacing-unit) * 2) 0
                 calc(var(--spacing-unit) * 3);
    }

    .game-intro {
        text-align: center;
        margin-bottom: calc(var(--spacing-unit) * 2);
    }

    .game-intro h1 {
        margin: 0 0 var(--spacing-unit);
        color: var(--theme-color);
        font-size: 1.75rem;
    }

    .game-intro p {
        max-width: 700px;
        margin: 0 auto;
        color: var(--muted-text-color);
        font-size: 1rem;
        line-height: 1.6;
    }

    .game-window {
        width: 100%;
        box-sizing: border-box;
        padding: var(--spacing-unit);
        border-radius: var(--border-radius);
        background: darkgrey;
    }
</style>